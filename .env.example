# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME=Prescriptionly
APP_URL=http://localhost:5173

# Database (MySQL)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/prescriptionly"

# Security & Sessions
SESSION_SECRET="prescriptionly_development_session_secret_min_32_characters_long_12345"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# Storage
STORAGE_LOCAL_DIR="./uploads"
MAX_FILE_SIZE_BYTES=15728640

# ==============================================================================
# AI & OCR Model Configuration (Zero Lock-in: Gemini, OpenAI, AgentRouter, etc.)
# ==============================================================================
# 1. API Key: Paste your AgentRouter token, Google Gemini Key, or OpenAI API Key
#    (Leave empty to safely deactivate live calls and use the local resilient engine)
AI_API_KEY=""

# 2. Selected Model:
#    - Direct Gemini   : gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
#    - Direct OpenAI   : gpt-4o, gpt-4o-mini, o1, o3-mini
#    - Via AgentRouter : gpt-4o, claude-3-5-sonnet-20241022, deepseek-v4-flash, gemini-1.5-pro, etc.
#    - Local/Offline   : mock, local
AI_MODEL="gemini-1.5-flash"

# 3. Base URL (Optional - set for AgentRouter or any OpenAI-compatible gateway):
#    - For AgentRouter: https://agentrouter.org/v1
#    - For Direct API : leave empty
AI_BASE_URL=""
# 'GEMINI' | 'OPENAI' | 'AGENTROUTER' | 'MOCK' = 'MOCK';
AI_PROVIDER=""