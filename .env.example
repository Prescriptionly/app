# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME=Prescriptionly
APP_URL=http://localhost:5173

# Database (MySQL)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/prescriptionly"

# Security & Sessions
SESSION_SECRET="prescriptionly_development_session_secret_min_32_characters_long_12345"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# Storage
STORAGE_LOCAL_DIR="./uploads"
MAX_FILE_SIZE_BYTES=15728640

# ==============================================================================
# AI & OCR Model Configuration (Activate/Deactivate)
# ==============================================================================
# 1. API Key: Paste your Google Gemini or OpenAI API Key
#    (Leave empty or comment out to safely deactivate live calls and use the local engine)
AI_API_KEY=""

# 2. Selected Model:
#    - Gemini Models : gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro, gemini-2.5-flash
#    - OpenAI Models : gpt-4o, gpt-4o-mini, gpt-4-turbo, o1, o3-mini
#    - Local/Mock    : mock, local, offline
AI_MODEL="gemini-1.5-flash"
