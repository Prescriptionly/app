# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME=Prescriptionly
APP_URL=http://localhost:5173

# Database (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/prescriptionly"

# Security & Sessions
SESSION_SECRET="prescriptionly_development_session_secret_min_32_characters_long_12345"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# Storage
STORAGE_LOCAL_DIR="./uploads"
MAX_FILE_SIZE_BYTES=15728640

# AI / OCR Providers (Optional / Fallback to local mock)
OCR_PROVIDER="mock"
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
